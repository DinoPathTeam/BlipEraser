# Asegurar que podemos importar blip_eraser desde la instalación del sistema
# El paquete se instala en /usr/lib/python3.x/site-packages/blip_eraser
# o similar, que ya está en sys.path

from blip_eraser.daemon.privileged_daemon import main

if __name__ == "__main__":
    sys.exit(main())