post_install() {
  update-desktop-database -q usr/share/applications 2>/dev/null || true
  gtk-update-icon-cache -q -t -f usr/share/icons/hicolor 2>/dev/null || true
  systemctl daemon-reload 2>/dev/null || true
  if command -v apparmor_parser >/dev/null; then
    apparmor_parser -r /etc/apparmor.d/usr.lib.blip-eraser.blip-eraser-privileged 2>/dev/null || true
  fi
  echo "==> Habilita el daemon privilegiado con:"
  echo "      sudo systemctl enable --now blip-eraser-privileged.service"
  echo "    (requiere estar en el grupo wheel; si no, la app usa pkexec)"
}

post_upgrade() {
  post_install
}

post_remove() {
  update-desktop-database -q usr/share/applications 2>/dev/null || true
  gtk-update-icon-cache -q -t -f usr/share/icons/hicolor 2>/dev/null || true
  systemctl daemon-reload 2>/dev/null || true
}
