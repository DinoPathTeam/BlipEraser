#!/usr/bin/env python3
"""
Test script to verify the privileged daemon works outside of systemd.
Run as root: sudo python3 scripts/test-daemon
"""

import os
import sys
import subprocess

def check_root():
    if os.geteuid() != 0:
        print("ERROR: This script must be run as root")
        return False
    return True

def check_dependencies():
    """Check if all required packages are installed."""
    checks = [
        ("python3", "python3 --version"),
        ("PyGObject", "python3 -c 'import gi; gi.require_version(\"GLib\", \"2.0\"); from gi.repository import GLib, Gio'"),
        ("GStreamer libav", "gst-inspect-1.0 avdec_h264 >/dev/null 2>&1"),
        ("pacman", "pacman --version"),
        ("pacman-key", "pacman-key --version"),
        ("rm", "rm --version"),
    ]
    
    all_ok = True
    for name, cmd in checks:
        try:
            result = subprocess.run(cmd, shell=True, capture_output=True, timeout=5)
            if result.returncode == 0:
                print(f"✓ {name}")
            else:
                print(f"✗ {name}: {result.stderr.decode().strip()}")
                return False
        except Exception as e:
            print(f"✗ {name}: {e}")
            return False
    return True

def check_dbus():
    """Check if D-Bus system bus is available."""
    try:
        result = subprocess.run(["systemctl", "is-active", "dbus"], capture_output=True, timeout=5)
        if result.returncode == 0 and result.stdout.strip() == "active":
            print("✓ D-Bus system bus active")
            return True
        else:
            print("✗ D-Bus system bus not active")
            return False
    except Exception as e:
        print(f"✗ D-Bus check failed: {e}")
        return False

def check_dbus_policy():
    """Check if D-Bus policy file exists."""
    policy_path = "/usr/share/dbus-1/system.d/blip-eraser-privileged.conf"
    if os.path.exists(policy_path):
        print("✓ D-Bus policy file exists")
        return True
    else:
        print("✗ D-Bus policy file missing")
        return False

def check_apparmor():
    """Check AppArmor status."""
    try:
        result = subprocess.run(["systemctl", "is-active", "apparmor"], capture_output=True, timeout=5)
        if result.returncode == 0 and result.stdout.strip() == "active":
            print("✓ AppArmor active")
            return True
        else:
            print("⚠ AppArmor not active (may be disabled)")
            return True  # Not a hard failure
    except Exception:
        print("⚠ AppArmor check failed")
        return True

def check_systemd_service():
    """Check if systemd service is installed and enabled."""
    service_path = "/usr/lib/systemd/system/blip-eraser-privileged.service"
    if os.path.exists(service_path):
        print("✓ Systemd service file exists")
        # Check if enabled
        try:
            result = subprocess.run(["systemctl", "is-enabled", "blip-eraser-privileged"], capture_output=True, timeout=5)
            if result.returncode == 0:
                print("✓ Systemd service enabled")
            else:
                print("⚠ Systemd service not enabled")
        except Exception:
            print("⚠ Could not check systemd service status")
        return True
    else:
        print("✗ Systemd service file missing")
        return False

def main():
    print("=== BlipEraser Phase 2 Daemon - Pre-flight Check ===\n")
    
    if not check_root():
        return 1
    
    all_ok = True
    
    print("Checking dependencies...")
    all_ok &= check_dependencies()
    
    print("\nChecking D-Bus...")
    all_ok &= check_dbus()
    
    print("\nChecking D-Bus policy...")
    all_ok &= check_dbus_policy()
    
    print("\nChecking AppArmor...")
    all_ok &= check_apparmor()
    
    print("\nChecking systemd service...")
    all_ok &= check_systemd_service()
    
    print("\n" + "="*50)
    if all_ok:
        print("✓ All checks passed! The daemon should start correctly.")
        return 0
    else:
        print("✗ Some checks failed. Please fix the issues above.")
        return 1

if __name__ == "__main__":
    import os
    sys.exit(main())